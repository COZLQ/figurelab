# Optional server-side configuration. Copy to .env.local and fill your own key.
# .env.local is ignored by Git. Never use NEXT_PUBLIC_ for secrets.
FIGURELAB_AI_BASE_URL=https://api.deepseek.com
FIGURELAB_AI_MODEL=deepseek-flash
FIGURELAB_AI_API_KEY=
FIGURELAB_AI_JSON_MODE=true
# DEEPSEEK_API_KEY is also accepted if FIGURELAB_AI_API_KEY is not set.
# Local model endpoints require explicit opt-in; keep disabled for normal use.
# FIGURELAB_AI_ALLOW_LOCAL_ENDPOINT=true
